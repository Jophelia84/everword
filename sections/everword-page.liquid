{% doc %}
  A content page in the source's docpage layout: a ruled head carrying the
  title and standfirst, then the body in a measured column.

  The standfirst comes from the page's everword.summary metafield if present,
  which is what everword-pages.csv writes into the Summary column.
{% enddoc %}

<section class="ew-scope docpage" data-testid="everword-page">
  <div class="wrap">
    <div class="dochead">
      <h1>{{ page.title }}</h1>
      {%- assign summary = page.metafields.everword.summary.value -%}
      {%- if summary != blank -%}<p>{{ summary }}</p>{%- endif -%}
    </div>
    <div class="docbody">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Everword page",
  "tag": "section",
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
