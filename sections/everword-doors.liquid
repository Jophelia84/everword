{% doc %}
  "Shop by occasion" — the six full-bleed doors. In the standalone build these
  called a JS filter; here each one links to a real collection.
{% enddoc %}

<section class="ew-scope wrap" data-testid="everword-doors">
  {%- if section.settings.heading != blank or section.settings.body != blank -%}
    <div class="mid">
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
    </div>
  {%- endif -%}

  <div class="doors">
    {%- for block in section.blocks -%}
      {%- liquid
        assign target = block.settings.collection
        assign href = block.settings.link
        if href == blank and target != blank
          assign href = target.url
        endif
        assign image = block.settings.image
        if image == blank and target != blank
          assign image = target.featured_image
        endif

        comment
          An image_picker cannot carry a default and a collection may not have
          an image yet, so each door keeps the source's own photograph as a
          last resort rather than rendering as an empty tile.
        endcomment
        assign title = block.settings.title
        if title == blank and target != blank
          assign title = target.title
        endif
      -%}
      <a class="door" href="{{ href | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if image == blank and block.settings.default_asset != blank -%}
          <img alt="{{ title | escape }}" loading="lazy" src="{{ block.settings.default_asset | asset_url }}">
        {%- elsif image != blank -%}
          <img
            alt="{{ image.alt | default: title | escape }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
            src="{{ image | image_url: width: 800 }}"
            srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 860px) 50vw, 33vw"
          >
        {%- endif -%}
        <span class="cap">
          <b>{{ title }}</b>
          {% if block.settings.caption != blank %}<i>{{ block.settings.caption }}</i>{% endif %}
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Everword occasion doors",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by occasion" },
    { "type": "textarea", "id": "body", "label": "Body" }
  ],
  "blocks": [
    {
      "type": "door",
      "name": "Door",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the collection." },
        { "type": "text", "id": "default_asset", "label": "Fallback asset", "info": "A file in the theme's assets, used until an image is chosen and while the collection has none." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Everword occasion doors",
      "category": "Everword",
      "blocks": [
        { "type": "door", "settings": { "default_asset": "ew-inline-50fc9ed24f.webp", "title": "Birthdays", "caption": "The largest reason anyone buys" } },
        { "type": "door", "settings": { "default_asset": "ew-inline-d42b38ee5d.webp", "title": "In Memory", "caption": "For the ones we still talk to" } },
        { "type": "door", "settings": { "default_asset": "ew-inline-da5c90f02c.webp", "title": "Anniversaries", "caption": "A date, said once, kept" } },
        { "type": "door", "settings": { "default_asset": "ew-inline-fd7f233c08.webp", "title": "Milestones", "caption": "Graduations, and starting over" } },
        { "type": "door", "settings": { "default_asset": "ew-inline-4a57c57c4a.webp", "title": "For Him", "caption": "Engraved, and read by nobody else" } },
        { "type": "door", "settings": { "default_asset": "ew-inline-0a254e50fb.webp", "title": "A New Baby", "caption": "The year nobody has words for" } }
      ]
    }
  ]
}
{% endschema %}
