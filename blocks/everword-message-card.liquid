{% doc %}
  The free message card, as a theme block for the product page.

  Shown when the product's everword.message_card metafield says so, or — for
  products imported from a supplier app, which carry no such metafield — when
  this block is set to show it by default. Its inputs associate with the
  buy-buttons form by id, same as personalisation.
{% enddoc %}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign flag = product.metafields.everword.message_card
  if flag == blank
    assign enabled = block.settings.show_by_default
  else
    assign enabled = flag.value
  endif
-%}

{%- if product != blank and enabled -%}
  <div class="ew-scope ew-buy" {{ block.shopify_attributes }}>
    {%- assign ew_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
    {% render 'everword-message-card', product: product, form_id: ew_form_id %}
  </div>
  <script src="{{ 'everword-message-card.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Everword message card",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_by_default",
      "label": "Show on products without the metafield",
      "default": true,
      "info": "A product's everword.message_card metafield overrides this when it is set."
    }
  ],
  "presets": [{ "name": "Everword message card", "category": "Product" }]
}
{% endschema %}
