{% doc %}
  The free message card, as a theme block for Horizon's product page.
  Its inputs associate with the buy-buttons form by id, same as personalisation.
{% enddoc %}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  assign enabled = product.metafields.everword.message_card.value
-%}

{%- if product != blank and enabled -%}
  <div class="ew-scope" {{ block.shopify_attributes }}>
    {%- assign ew_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
    {% render 'everword-message-card', product: product, form_id: ew_form_id %}
  </div>
  <script src="{{ 'everword-message-card.js' | asset_url }}" defer="defer"></script>
{%- elsif request.design_mode -%}
  <div class="ew-scope" {{ block.shopify_attributes }}>
    <p class="cnt">This product has no message card. Set the
      <code>everword.message_card</code> metafield to true to switch it on.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Everword message card",
  "presets": [{ "name": "Everword message card", "category": "Product" }]
}
{% endschema %}
